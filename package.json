{
  "name": "omp-chat",
  "displayName": "OMP Chat by DT",
  "description": "AI coding agent chat for VS Code, powered by oh-my-pi (omp), with your own keys for OpenCode, OpenRouter, DeepSeek, Anthropic, OpenAI, Gemini and more.",
  "version": "0.6.11",
  "publisher": "dtcode-dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thangws4/omp-chat.git"
  },
  "homepage": "https://github.com/thangws4/omp-chat#readme",
  "bugs": {
    "url": "https://github.com/thangws4/omp-chat/issues"
  },
  "icon": "media/logo.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onWebviewPanel:ompChat.tab"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ompChat",
          "title": "OMP Chat",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "ompChat": [
        {
          "type": "webview",
          "id": "ompChat.view",
          "name": "%view.chat%"
        }
      ]
    },
    "commands": [
      {
        "command": "ompChat.focus",
        "title": "%command.focus%",
        "category": "OMP Chat"
      },
      {
        "command": "ompChat.newSession",
        "title": "%command.newSession%",
        "category": "OMP Chat",
        "icon": "$(add)"
      },
      {
        "command": "ompChat.history",
        "title": "%command.history%",
        "category": "OMP Chat",
        "icon": "$(history)"
      },
      {
        "command": "ompChat.usage",
        "title": "%command.usage%",
        "category": "OMP Chat",
        "icon": "$(graph)"
      },
      {
        "command": "ompChat.plugins",
        "title": "%command.plugins%",
        "category": "OMP Chat",
        "icon": "$(extensions)"
      },
      {
        "command": "ompChat.pickModel",
        "title": "%command.pickModel%",
        "category": "OMP Chat"
      },
      {
        "command": "ompChat.manageModels",
        "title": "%command.manageModels%",
        "category": "OMP Chat"
      },
      {
        "command": "ompChat.setApiKey",
        "title": "%command.setApiKey%",
        "category": "OMP Chat"
      },
      {
        "command": "ompChat.stop",
        "title": "%command.stop%",
        "category": "OMP Chat"
      },
      {
        "command": "ompChat.exportChat",
        "title": "%command.exportChat%",
        "category": "OMP Chat",
        "icon": "$(export)"
      },
      {
        "command": "ompChat.addFile",
        "title": "%command.addFile%",
        "category": "OMP Chat"
      },
      {
        "command": "ompChat.ask",
        "title": "%command.ask%",
        "category": "OMP Chat"
      },
      {
        "command": "ompChat.explain",
        "title": "%command.explain%",
        "category": "OMP Chat"
      },
      {
        "command": "ompChat.fix",
        "title": "%command.fix%",
        "category": "OMP Chat"
      },
      {
        "command": "ompChat.commands",
        "title": "%command.commands%",
        "category": "OMP Chat"
      },
      {
        "command": "ompChat.mcp",
        "title": "%command.mcp%",
        "category": "OMP Chat"
      },
      {
        "command": "ompChat.newTab",
        "title": "%command.newTab%",
        "category": "OMP Chat",
        "icon": "$(empty-window)"
      },
      {
        "command": "ompChat.newWorktreeChat",
        "title": "%command.newWorktreeChat%",
        "category": "OMP Chat",
        "icon": "$(git-branch)"
      },
      {
        "command": "ompChat.chats",
        "title": "%command.chats%",
        "category": "OMP Chat",
        "icon": "$(list-unordered)"
      },
      {
        "command": "ompChat.attention",
        "title": "%command.attention%",
        "category": "OMP Chat"
      },
      {
        "command": "ompChat.nextChange",
        "title": "%command.nextChange%",
        "category": "OMP Chat",
        "enablement": "ompChat.reviewing"
      },
      {
        "command": "ompChat.prevChange",
        "title": "%command.prevChange%",
        "category": "OMP Chat",
        "enablement": "ompChat.reviewing"
      },
      {
        "command": "ompChat.acceptChange",
        "title": "%command.acceptChange%",
        "category": "OMP Chat",
        "enablement": "ompChat.inChange"
      },
      {
        "command": "ompChat.rejectChange",
        "title": "%command.rejectChange%",
        "category": "OMP Chat",
        "enablement": "ompChat.inChange"
      },
      {
        "command": "ompChat.compareReview",
        "title": "%command.compareReview%",
        "category": "OMP Chat",
        "icon": "$(diff)",
        "enablement": "ompChat.reviewing"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ompChat.newSession",
          "when": "view == ompChat.view",
          "group": "navigation@1"
        },
        {
          "command": "ompChat.history",
          "when": "view == ompChat.view",
          "group": "navigation@2"
        },
        {
          "command": "ompChat.usage",
          "when": "view == ompChat.view",
          "group": "navigation@3"
        },
        {
          "command": "ompChat.plugins",
          "when": "view == ompChat.view",
          "group": "navigation@4"
        },
        {
          "command": "ompChat.pickModel",
          "when": "view == ompChat.view",
          "group": "1_settings@1"
        },
        {
          "command": "ompChat.manageModels",
          "when": "view == ompChat.view",
          "group": "1_settings@1"
        },
        {
          "command": "ompChat.setApiKey",
          "when": "view == ompChat.view",
          "group": "1_settings@2"
        },
        {
          "command": "ompChat.exportChat",
          "when": "view == ompChat.view",
          "group": "2_chat@1"
        },
        {
          "command": "ompChat.commands",
          "when": "view == ompChat.view",
          "group": "2_chat@2"
        },
        {
          "command": "ompChat.mcp",
          "when": "view == ompChat.view",
          "group": "2_chat@3"
        },
        {
          "command": "ompChat.newTab",
          "when": "view == ompChat.view",
          "group": "0_chats@1"
        },
        {
          "command": "ompChat.newWorktreeChat",
          "when": "view == ompChat.view",
          "group": "0_chats@2"
        },
        {
          "command": "ompChat.chats",
          "when": "view == ompChat.view",
          "group": "0_chats@3"
        }
      ],
      "editor/context": [
        {
          "command": "ompChat.ask",
          "group": "0_ompChat@1"
        },
        {
          "command": "ompChat.explain",
          "when": "editorHasSelection",
          "group": "0_ompChat@2"
        },
        {
          "command": "ompChat.fix",
          "group": "0_ompChat@3"
        }
      ],
      "explorer/context": [
        {
          "command": "ompChat.addFile",
          "when": "!explorerResourceIsFolder",
          "group": "0_ompChat@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "ompChat.addFile",
          "group": "0_ompChat@1"
        }
      ],
      "editor/title": [
        {
          "command": "ompChat.newSession",
          "when": "activeWebviewPanelId == 'ompChat.tab'",
          "group": "navigation@1"
        },
        {
          "command": "ompChat.history",
          "when": "activeWebviewPanelId == 'ompChat.tab'",
          "group": "navigation@2"
        },
        {
          "command": "ompChat.usage",
          "when": "activeWebviewPanelId == 'ompChat.tab'",
          "group": "navigation@3"
        },
        {
          "command": "ompChat.chats",
          "when": "activeWebviewPanelId == 'ompChat.tab'",
          "group": "navigation@4"
        }
      ]
    },
    "configuration": {
      "title": "OMP Chat",
      "properties": {
        "ompChat.ompPath": {
          "type": "string",
          "default": "omp",
          "description": "%config.ompPath%"
        },
        "ompChat.model": {
          "type": "string",
          "default": "openrouter/baidu/ernie-5.5-flash-preview:free",
          "description": "%config.model%"
        },
        "ompChat.approvalMode": {
          "type": "string",
          "enum": [
            "always-ask",
            "always-ask-cached",
            "write",
            "yolo",
            "plan"
          ],
          "enumDescriptions": [
            "%config.approvalMode.always-ask%",
            "%config.approvalMode.always-ask-cached%",
            "%config.approvalMode.write%",
            "%config.approvalMode.yolo%",
            "%config.approvalMode.plan%"
          ],
          "default": "always-ask",
          "description": "%config.approvalMode%"
        },
        "ompChat.thinkingLevel": {
          "type": "string",
          "enum": [
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "default": "high",
          "description": "%config.thinkingLevel%"
        },
        "ompChat.announceSteps": {
          "type": "boolean",
          "default": true,
          "description": "%config.announceSteps%"
        },
        "ompChat.notifications": {
          "type": "boolean",
          "default": true,
          "description": "%config.notifications%"
        },
        "ompChat.allowedCommands": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "markdownDescription": "%config.allowedCommands%"
        },
        "ompChat.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.extraArgs%"
        }
      }
    },
    "keybindings": [
      {
        "command": "ompChat.focus",
        "key": "ctrl+alt+o",
        "mac": "cmd+alt+o"
      },
      {
        "command": "ompChat.ask",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "editorTextFocus"
      },
      {
        "command": "ompChat.nextChange",
        "key": "f7",
        "when": "ompChat.reviewing && editorTextFocus && !isInDiffEditor"
      },
      {
        "command": "ompChat.prevChange",
        "key": "shift+f7",
        "when": "ompChat.reviewing && editorTextFocus && !isInDiffEditor"
      },
      {
        "command": "ompChat.acceptChange",
        "key": "alt+y",
        "mac": "cmd+alt+y",
        "when": "ompChat.inChange && editorTextFocus"
      },
      {
        "command": "ompChat.rejectChange",
        "key": "alt+n",
        "mac": "cmd+alt+n",
        "when": "ompChat.inChange && editorTextFocus"
      }
    ]
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\""
  }
}
