{
  "name": "omp-chat",
  "displayName": "OMP Chat by DT",
  "description": "AI coding chat panel for VS Code, powered by the oh-my-pi (omp) agent and OpenRouter / DeepSeek models.",
  "version": "0.4.2",
  "publisher": "dtcode-dev",
  "icon": "media/logo.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ompChat",
          "title": "OMP Chat",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "ompChat": [
        {
          "type": "webview",
          "id": "ompChat.view",
          "name": "%view.chat%"
        }
      ]
    },
    "commands": [
      {
        "command": "ompChat.focus",
        "title": "%command.focus%",
        "category": "OMP Chat"
      },
      {
        "command": "ompChat.newSession",
        "title": "%command.newSession%",
        "category": "OMP Chat",
        "icon": "$(add)"
      },
      {
        "command": "ompChat.history",
        "title": "%command.history%",
        "category": "OMP Chat",
        "icon": "$(history)"
      },
      {
        "command": "ompChat.usage",
        "title": "%command.usage%",
        "category": "OMP Chat",
        "icon": "$(graph)"
      },
      {
        "command": "ompChat.plugins",
        "title": "%command.plugins%",
        "category": "OMP Chat",
        "icon": "$(extensions)"
      },
      {
        "command": "ompChat.pickModel",
        "title": "%command.pickModel%",
        "category": "OMP Chat"
      },
      {
        "command": "ompChat.manageModels",
        "title": "%command.manageModels%",
        "category": "OMP Chat"
      },
      {
        "command": "ompChat.setApiKey",
        "title": "%command.setApiKey%",
        "category": "OMP Chat"
      },
      {
        "command": "ompChat.stop",
        "title": "%command.stop%",
        "category": "OMP Chat"
      },
      {
        "command": "ompChat.exportChat",
        "title": "%command.exportChat%",
        "category": "OMP Chat",
        "icon": "$(export)"
      },
      {
        "command": "ompChat.addFile",
        "title": "%command.addFile%",
        "category": "OMP Chat"
      },
      {
        "command": "ompChat.ask",
        "title": "%command.ask%",
        "category": "OMP Chat"
      },
      {
        "command": "ompChat.explain",
        "title": "%command.explain%",
        "category": "OMP Chat"
      },
      {
        "command": "ompChat.fix",
        "title": "%command.fix%",
        "category": "OMP Chat"
      },
      {
        "command": "ompChat.commands",
        "title": "%command.commands%",
        "category": "OMP Chat"
      },
      {
        "command": "ompChat.mcp",
        "title": "%command.mcp%",
        "category": "OMP Chat"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ompChat.newSession",
          "when": "view == ompChat.view",
          "group": "navigation@1"
        },
        {
          "command": "ompChat.history",
          "when": "view == ompChat.view",
          "group": "navigation@2"
        },
        {
          "command": "ompChat.usage",
          "when": "view == ompChat.view",
          "group": "navigation@3"
        },
        {
          "command": "ompChat.plugins",
          "when": "view == ompChat.view",
          "group": "navigation@4"
        },
        {
          "command": "ompChat.pickModel",
          "when": "view == ompChat.view",
          "group": "1_settings@1"
        },
        {
          "command": "ompChat.manageModels",
          "when": "view == ompChat.view",
          "group": "1_settings@1"
        },
        {
          "command": "ompChat.setApiKey",
          "when": "view == ompChat.view",
          "group": "1_settings@2"
        },
        {
          "command": "ompChat.exportChat",
          "when": "view == ompChat.view",
          "group": "2_chat@1"
        },
        {
          "command": "ompChat.commands",
          "when": "view == ompChat.view",
          "group": "2_chat@2"
        },
        {
          "command": "ompChat.mcp",
          "when": "view == ompChat.view",
          "group": "2_chat@3"
        }
      ],
      "editor/context": [
        {
          "command": "ompChat.ask",
          "group": "0_ompChat@1"
        },
        {
          "command": "ompChat.explain",
          "when": "editorHasSelection",
          "group": "0_ompChat@2"
        },
        {
          "command": "ompChat.fix",
          "group": "0_ompChat@3"
        }
      ],
      "explorer/context": [
        {
          "command": "ompChat.addFile",
          "when": "!explorerResourceIsFolder",
          "group": "0_ompChat@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "ompChat.addFile",
          "group": "0_ompChat@1"
        }
      ]
    },
    "configuration": {
      "title": "OMP Chat",
      "properties": {
        "ompChat.ompPath": {
          "type": "string",
          "default": "omp",
          "description": "%config.ompPath%"
        },
        "ompChat.model": {
          "type": "string",
          "default": "openrouter/baidu/ernie-5.5-flash-preview:free",
          "description": "%config.model%"
        },
        "ompChat.approvalMode": {
          "type": "string",
          "enum": [
            "always-ask",
            "always-ask-cached",
            "write",
            "yolo",
            "plan"
          ],
          "enumDescriptions": [
            "%config.approvalMode.always-ask%",
            "%config.approvalMode.always-ask-cached%",
            "%config.approvalMode.write%",
            "%config.approvalMode.yolo%",
            "%config.approvalMode.plan%"
          ],
          "default": "always-ask",
          "description": "%config.approvalMode%"
        },
        "ompChat.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.extraArgs%"
        }
      }
    }
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\""
  }
}
